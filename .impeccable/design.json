  "components": [
    {
      "name": "Result Card",
      "kind": "card",
      "refersTo": "result-card",
      "description": "The answer printed as a syringe label: violet band, 2px ink rule, one huge condensed figure, the assumptions beneath.",
      "html": "<div class=\"ds-label\"><div class=\"ds-label-band\"><span class=\"ds-label-drug\">NORADRENALINE</span><span class=\"ds-label-conc\">50 mcg/mL</span></div><div class=\"ds-label-body\"><div class=\"ds-label-value\"><span class=\"ds-label-fig\">8.4</span><span class=\"ds-label-unit\">mL/h</span></div><p class=\"ds-label-basis\">for 0.1&nbsp;mcg/kg/min at 70&nbsp;kg</p><p class=\"ds-label-summary\">10 &times; 1&nbsp;mg/1&nbsp;mL into 200&nbsp;mL (10&nbsp;mL removed) = 50&nbsp;mcg/mL</p></div></div>",
      "css": ".ds-label{background:#FFFFFF;border:1px solid #D6CFDD;border-radius:8px;overflow:hidden;color:#1C1822;max-width:380px}.ds-label-band{background:#C9A2DC;color:#1C1822;display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:8px 16px 6px;border-bottom:2px solid #1C1822}.ds-label-drug{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:28px;line-height:34px;letter-spacing:.4px;text-transform:uppercase}.ds-label-conc{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:19px;font-variant-numeric:tabular-nums}.ds-label-body{padding:12px 16px}.ds-label-value{display:flex;align-items:baseline;gap:8px}.ds-label-fig{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:84px;line-height:92px;letter-spacing:-1px;font-variant-numeric:tabular-nums}.ds-label-unit{font-family:'Barlow',sans-serif;font-weight:600;font-size:22px}.ds-label-basis{font-family:'Barlow',sans-serif;font-weight:600;font-size:16px;line-height:22px;margin:0}.ds-label-summary{font-family:'Barlow',sans-serif;font-size:15px;line-height:21px;color:#5E5668;margin:2px 0 0}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Quick pick for drugs, bag sizes and remembered strengths; selected prints in ink.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">Adrenaline</button><button class=\"ds-chip ds-chip-on\" aria-pressed=\"true\">Noradrenaline</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{font-family:'Barlow',sans-serif;font-weight:600;font-size:16px;min-height:44px;padding:0 14px;border-radius:8px;border:1.5px solid #D6CFDD;background:#FFFFFF;color:#1C1822;cursor:pointer}.ds-chip:active{background:#EDE3F3}.ds-chip:focus-visible{outline:2px solid #5A2D75;outline-offset:2px}.ds-chip-on{background:#1C1822;border-color:#1C1822;color:#F3F0F6}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-selected",
      "description": "One choice of a few, always visible; selected segment fills violet.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button class=\"ds-seg-item ds-seg-on\" role=\"radio\" aria-checked=\"true\">Find rate</button><button class=\"ds-seg-item\" role=\"radio\" aria-checked=\"false\">Find dose</button></div>",
      "css": ".ds-seg{display:flex;gap:2px;padding:2px;border:1.5px solid #D6CFDD;border-radius:10px;max-width:360px}.ds-seg-item{flex:1;min-height:44px;border:0;border-radius:8px;background:transparent;color:#1C1822;font-family:'Barlow',sans-serif;font-weight:600;font-size:16px;cursor:pointer}.ds-seg-item:active{background:#EDE3F3}.ds-seg-item:focus-visible{outline:2px solid #5A2D75}.ds-seg-on{background:#5A2D75;color:#FFFFFF}"
    },
    {
      "name": "Number Field with Unit",
      "kind": "input",
      "refersTo": "number-field",
      "description": "56dp numeric field; a changeable unit is a violet button with a drawn chevron. Never a numeric placeholder.",
      "html": "<label class=\"ds-nf\"><span class=\"ds-nf-label\">Amount</span><span class=\"ds-nf-box\"><input class=\"ds-nf-input\" inputmode=\"decimal\" value=\"1\"><button class=\"ds-nf-unit\">mg<i class=\"ds-chev\"></i></button></span></label>",
      "css": ".ds-nf{display:block;max-width:220px}.ds-nf-label{display:block;font-family:'Barlow',sans-serif;font-weight:600;font-size:14px;color:#5E5668;margin-bottom:4px}.ds-nf-box{display:flex;align-items:stretch;min-height:56px;background:#FFFFFF;border:1.5px solid #D6CFDD;border-radius:10px;overflow:hidden}.ds-nf-box:focus-within{border:2px solid #5A2D75}.ds-nf-input{flex:1;min-width:48px;border:0;outline:0;background:transparent;color:#1C1822;caret-color:#5A2D75;font-family:'Barlow',sans-serif;font-weight:600;font-size:24px;padding:8px 12px;font-variant-numeric:tabular-nums}.ds-nf-unit{display:flex;align-items:center;gap:8px;min-width:48px;padding:0 12px;border:0;border-left:1px solid #D6CFDD;background:transparent;color:#5A2D75;font-family:'Barlow',sans-serif;font-weight:700;font-size:16px;cursor:pointer}.ds-nf-unit:active{background:#EDE3F3}.ds-chev{width:7px;height:7px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);margin-top:-3px}"
    },
    {
      "name": "Unconfirmed Field",
      "kind": "input",
      "refersTo": "number-field-unconfirmed",
      "description": "A remembered strength not yet checked against the ampoule: amber wash, dashed amber border.",
      "html": "<span class=\"ds-nf-old\"><input class=\"ds-nf-old-input\" value=\"1\"><span class=\"ds-nf-old-sfx\">mL</span></span>",
      "css": ".ds-nf-old{display:flex;align-items:center;max-width:200px;min-height:56px;background:#FCEFD8;border:1.5px dashed #B86A00;border-radius:10px}.ds-nf-old:focus-within{border:2px solid #5A2D75}.ds-nf-old-input{flex:1;min-width:48px;border:0;outline:0;background:transparent;color:#5C3500;font-family:'Barlow',sans-serif;font-weight:600;font-size:24px;padding:8px 12px}.ds-nf-old-sfx{font-family:'Barlow',sans-serif;font-weight:600;font-size:16px;color:#5E5668;margin-right:12px}"
    },
    {
      "name": "Old-Strength Stamp",
      "kind": "custom",
      "refersTo": "button-confirm",
      "description": "Dashed amber stamp asking the clinician to confirm a remembered strength, with the violet confirm button.",
      "html": "<div class=\"ds-stamp\"><div><div class=\"ds-stamp-title\">Old · used 2 days ago</div><div class=\"ds-stamp-body\">Check it against the ampoule in your hand.</div></div><button class=\"ds-confirm\">Matches my ampoule</button></div>",
